<Window x:Class="VisionFlow.WpfToolEditors.Editors.WpfDescriptorMatchToolEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VisionFlow.WpfToolEditors.Controls"
        Title="描述子匹配编辑"
        Width="1240"
        Height="800"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0">
            <controls:WpfRoiEditorControl x:Name="TeachRoiEditor" />
        </Border>

        <ScrollViewer Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="示教" Style="{StaticResource EditorSectionTitleStyle}" />
                        <TextBlock Text="模块名" Style="{StaticResource EditorFieldLabelStyle}" />
                        <TextBox x:Name="ModuleNameText" />
                        <TextBlock Text="运行图像" Style="{StaticResource EditorFieldLabelStyle}" />
                        <ComboBox x:Name="ImagePathCombo" IsEditable="True" />
                        <Button Content="显示当前输入图像" Margin="0,12,0,0" Click="ShowInputImage_Click" />
                        <TextBlock x:Name="TemplateStateText" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <Button x:Name="CreateModelButton" Content="创建模型" Margin="0,12,0,0"
                                Style="{StaticResource AccentButtonStyle}" Click="CreateModel_Click" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="用工具栏打开参考图像（或显示当前输入图像），绘制一个矩形 ROI 框住纹理丰富的目标面，点击创建模型。流程只保存模板图与参数；模型在预热或首次运行时训练（数秒到数十秒），并缓存到本机，之后加载只需几十毫秒。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="训练参数" Style="{StaticResource EditorSectionTitleStyle}" />
                        <TextBlock Text="特征检测器" Style="{StaticResource EditorFieldLabelStyle}" />
                        <ComboBox x:Name="DetectorTypeCombo" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="深度 depth" Style="{StaticResource EditorFieldLabelStyle}" />
                                <controls:NumericInputControl x:Name="DepthText" Minimum="1" Maximum="15" Increment="1" DecimalPlaces="0" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="蕨数量 ferns" Style="{StaticResource EditorFieldLabelStyle}" />
                                <controls:NumericInputControl x:Name="NumberFernsText" Minimum="1" Maximum="200" Increment="1" DecimalPlaces="0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="块尺寸 patch" Style="{StaticResource EditorFieldLabelStyle}" />
                                <controls:NumericInputControl x:Name="PatchSizeText" Minimum="5" Maximum="61" Increment="2" DecimalPlaces="0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="随机种子" Style="{StaticResource EditorFieldLabelStyle}" />
                                <controls:NumericInputControl x:Name="SeedText" Minimum="0" Maximum="1000000" Increment="1" DecimalPlaces="0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="最小尺度" Style="{StaticResource EditorFieldLabelStyle}" />
                                <controls:NumericInputControl x:Name="MinScaleText" Minimum="0.1" Maximum="1" Increment="0.05" DecimalPlaces="2" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="最大尺度" Style="{StaticResource EditorFieldLabelStyle}" />
                                <controls:NumericInputControl x:Name="MaxScaleText" Minimum="1" Maximum="10" Increment="0.05" DecimalPlaces="2" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="查找参数" Style="{StaticResource EditorSectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="最小得分" Style="{StaticResource EditorFieldLabelStyle}" />
                                <controls:NumericInputControl x:Name="MinScoreText" Minimum="0" Maximum="1000" Increment="0.05" DecimalPlaces="2" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="数量" Style="{StaticResource EditorFieldLabelStyle}" />
                                <controls:NumericInputControl x:Name="NumMatchesText" Minimum="1" Maximum="100" Increment="1" DecimalPlaces="0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="得分类型" Style="{StaticResource EditorFieldLabelStyle}" />
                        <ComboBox x:Name="ScoreTypeCombo" />
                        <CheckBox x:Name="FailWhenNotFoundCheck" Margin="0,12,0,0" Content="未匹配到目标时失败（取消后输出 Found=false 并继续）" />
                        <CheckBox x:Name="UseModelFileCacheCheck" Margin="0,8,0,0" Content="使用本机模型缓存" />
                        <Button x:Name="TestMatchButton" Content="在当前图像上测试匹配" Margin="0,12,0,0" Click="TestMatch_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" LastChildFill="False" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="820"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button DockPanel.Dock="Right" Content="取消" MinWidth="96" Margin="8,0,0,0" Click="Cancel_Click" />
            <Button x:Name="OkButton" DockPanel.Dock="Right" Content="确定" MinWidth="96" Style="{StaticResource AccentButtonStyle}" Click="Ok_Click" />
        </DockPanel>
    </Grid>
</Window>
