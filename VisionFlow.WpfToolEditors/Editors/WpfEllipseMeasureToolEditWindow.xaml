<Window x:Class="VisionFlow.WpfToolEditors.Editors.WpfEllipseMeasureToolEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="椭圆测量编辑"
        Width="620"
        Height="640"
        MinWidth="560"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource EditorCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="模块名" Style="{StaticResource EditorFieldLabelStyle}" />
                    <TextBox x:Name="ModuleNameText" Grid.Row="0" Grid.Column="1" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="图像" Style="{StaticResource EditorFieldLabelStyle}" />
                    <ComboBox x:Name="ImagePathCombo" Grid.Row="1" Grid.Column="1" IsEditable="True" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="变换矩阵" Style="{StaticResource EditorFieldLabelStyle}" />
                    <ComboBox x:Name="MatrixPathCombo" Grid.Row="2" Grid.Column="1" IsEditable="True" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="结果序号" Style="{StaticResource EditorFieldLabelStyle}" />
                    <ComboBox x:Name="IndexPathCombo" Grid.Row="3" Grid.Column="1" IsEditable="True" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="椭圆行" Style="{StaticResource EditorFieldLabelStyle}" />
                    <TextBox x:Name="EllipseRowText" Grid.Row="4" Grid.Column="1" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="椭圆列" Style="{StaticResource EditorFieldLabelStyle}" />
                    <TextBox x:Name="EllipseColumnText" Grid.Row="5" Grid.Column="1" />
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="椭圆角度" Style="{StaticResource EditorFieldLabelStyle}" />
                    <TextBox x:Name="EllipseAngleText" Grid.Row="6" Grid.Column="1" />
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="半轴长1" Style="{StaticResource EditorFieldLabelStyle}" />
                    <TextBox x:Name="EllipseLength1Text" Grid.Row="7" Grid.Column="1" />
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="半轴长2" Style="{StaticResource EditorFieldLabelStyle}" />
                    <TextBox x:Name="EllipseLength2Text" Grid.Row="8" Grid.Column="1" />
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="测量长度" Style="{StaticResource EditorFieldLabelStyle}" />
                    <TextBox x:Name="MeasureLength1Text" Grid.Row="9" Grid.Column="1" />
                    <TextBlock Grid.Row="10" Grid.Column="0" Text="平滑 Sigma" Style="{StaticResource EditorFieldLabelStyle}" />
                    <TextBox x:Name="MeasureSigmaText" Grid.Row="10" Grid.Column="1" />
                    <TextBlock Grid.Row="11" Grid.Column="0" Text="边缘阈值" Style="{StaticResource EditorFieldLabelStyle}" />
                    <TextBox x:Name="MeasureThresholdText" Grid.Row="11" Grid.Column="1" />
                </Grid>
            </Border>
        </ScrollViewer>
        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button DockPanel.Dock="Right" Content="取消" MinWidth="96" Margin="8,0,0,0" Click="Cancel_Click" />
            <Button DockPanel.Dock="Right" Content="确定" MinWidth="96" Style="{StaticResource AccentButtonStyle}" Click="Ok_Click" />
        </DockPanel>
    </Grid>
</Window>
