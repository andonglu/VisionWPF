<Window x:Class="VisionFlow.WpfToolEditors.Editors.WpfArrayProcessToolEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数组处理"
        Width="1180"
        Height="760"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="440" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <Border Style="{StaticResource EditorCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="模块名" Style="{StaticResource EditorFieldLabelStyle}" />
                        <TextBox x:Name="ModuleNameText" Grid.Column="1" Height="32" VerticalContentAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="输入" Style="{StaticResource EditorSectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="数组" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="ArrayPathCombo" Grid.Column="1" IsEditable="True" Height="32" />
                            <TextBlock x:Name="SecondLabel" Grid.Row="2" Text="第二个数组" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="SecondPathCombo" Grid.Row="2" Grid.Column="1" IsEditable="True" Height="32"
                                      ToolTip="拼接、逐元素运算使用；逐元素运算时也可以是单个数值" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="操作" Style="{StaticResource EditorSectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="操作" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="OperationCombo" Grid.Column="1" Height="32" DisplayMemberPath="Label" SelectionChanged="OperationCombo_SelectionChanged" />
                            <TextBlock Grid.Column="3" Text="元素类型" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="ElementTypeCombo" Grid.Column="4" Height="32" SelectionChanged="ElementTypeCombo_SelectionChanged" />
                            <TextBlock x:Name="OperationHelpText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <Grid x:Name="IndexPanel" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="序号" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="IndexText" Grid.Column="1" Height="32" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="从 0 开始；负数从末尾数，-1 为最后一个"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <CheckBox x:Name="DescendingCheck" Margin="96,12,0,0" Content="降序（NaN 总在最后）" />

                        <Grid x:Name="OperatorPanel" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="运算" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="OperatorCombo" Grid.Column="1" Height="32" DisplayMemberPath="Label" />
                            <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="个数相等时逐一对应，一侧只有一个元素时与另一侧每个元素运算；除数为 0 时结果为 NaN"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <StackPanel x:Name="ExpressionPanel" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="表达式" Style="{StaticResource EditorFieldLabelStyle}" />
                                <TextBox x:Name="ExpressionText" Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                                         FontFamily="Consolas, Microsoft YaHei UI" TextChanged="ExpressionText_TextChanged" />
                            </Grid>
                            <WrapPanel Margin="96,8,0,0">
                                <Button Content="插入 {Item}" Margin="0,0,8,0" Click="InsertItem_Click" />
                                <Button Content="插入 {ItemIndex}" Margin="0,0,8,0" Click="InsertItemIndex_Click" />
                                <ComboBox x:Name="ReferenceCombo" Width="220" Margin="0,0,8,0" ToolTip="选择后插入流程变量引用" SelectionChanged="ReferenceCombo_SelectionChanged" />
                            </WrapPanel>
                            <TextBlock x:Name="ExpressionCheckText" Margin="96,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <CheckBox x:Name="FailWhenNotFoundCheck" Margin="96,16,0,0" Content="结果为空时节点失败（关闭后输出 Found=false 并继续）" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource EditorCardStyle}" Margin="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,10">
                    <TextBlock Text="预览" Style="{StaticResource EditorSectionTitleStyle}" Margin="0" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="运行预览" MinWidth="96" Click="RunPreview_Click" />
                </DockPanel>
                <DataGrid x:Name="StatsGrid" DockPanel.Dock="Bottom" Height="230" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                          RowHeight="26" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="统计" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="ValuesGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="26" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Position}" Width="60" />
                        <DataGridTextColumn Header="原序号" Binding="{Binding SourceIndex}" Width="70" />
                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" LastChildFill="False" Margin="0,24,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="760"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button DockPanel.Dock="Right" Content="取消" MinWidth="96" Margin="8,0,0,0" Click="Cancel_Click" />
            <Button DockPanel.Dock="Right" Content="确定" MinWidth="96" Style="{StaticResource AccentButtonStyle}" Click="Ok_Click" />
        </DockPanel>
    </Grid>
</Window>
