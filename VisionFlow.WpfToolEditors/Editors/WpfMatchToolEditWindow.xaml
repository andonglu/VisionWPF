<Window x:Class="VisionFlow.WpfToolEditors.Editors.WpfMatchToolEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:vfc="clr-namespace:VisionFlow.Controls;assembly=VisionFlow.Controls"
        xmlns:editorControls="clr-namespace:VisionFlow.WpfToolEditors.Controls"
        Title="模板匹配编辑"
        Width="1320"
        Height="860"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" TabStripPlacement="Right">
            <TabItem Header="示教建模">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="ROI 示教区域" Style="{StaticResource EditorSectionTitleStyle}" />
                            <editorControls:WpfRoiEditorControl x:Name="TeachRoiEditor" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="模板状态" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <TextBlock x:Name="ModelStateText" Text="模型：未创建" FontWeight="SemiBold" />
                                    <TextBlock Text="支持多个包含 ROI 合成一个模板区域；排除 ROI 会从区域中扣除。"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="ModelSourceCard" Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="模型来源" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <ComboBox x:Name="ModelSourceCombo" SelectionChanged="ModelSourceCombo_SelectionChanged" />
                                    <StackPanel x:Name="XldSourcePanel" Margin="0,8,0,0">
                                        <TextBlock Text="XLD 轮廓（上游输出）" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="TeachXldCombo" IsEditable="True" />
                                    </StackPanel>
                                    <StackPanel x:Name="DxfSourcePanel" Margin="0,8,0,0">
                                        <TextBlock Text="DXF 文件" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="DxfPathText" Grid.Column="0" />
                                            <Button Grid.Column="1" Content="..." MinWidth="32" Width="32" Padding="0" Click="BrowseDxf_Click" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel x:Name="ContourIndexPanel" Margin="0,8,0,0">
                                        <TextBlock Text="轮廓序号（-1 = 全部轮廓）" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="TeachXldIndexText" />
                                    </StackPanel>
                                    <TextBlock x:Name="XldMetricHintText" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="XLD / DXF 建模：XLD 没有灰度信息，度量固定为 ignore_local_polarity，对比度参数不生效（已锁定）。多条轮廓共同组成模板，可按序号只取一条。DXF 只在示教时读取，运行不依赖该文件。" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="创建模板参数" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="起始角" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="TeachAngleStartText" Grid.Row="0" Grid.Column="1" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="角范围" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="TeachAngleExtentText" Grid.Row="1" Grid.Column="1" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="角步长" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="TeachAngleStepText" Grid.Row="2" Grid.Column="1" IsEditable="True" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="金字塔" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="TeachNumLevelsText" Grid.Row="3" Grid.Column="1" IsEditable="True" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="对比度" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="TeachContrastText" Grid.Row="4" Grid.Column="1" IsEditable="True" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="最小对比" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="TeachMinContrastText" Grid.Row="5" Grid.Column="1" IsEditable="True" />
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="优化" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="TeachOptimizationCombo" Grid.Row="6" Grid.Column="1" />
                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="极性" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="TeachMetricCombo" Grid.Row="7" Grid.Column="1" />
                                    </Grid>
                                    <StackPanel x:Name="ScaledShapePanel" Margin="0,12,0,0">
                                        <TextBlock Text="缩放形状参数" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="最小缩放" Style="{StaticResource EditorFieldLabelStyle}" />
                                            <TextBox x:Name="ScaleMinText" Grid.Row="0" Grid.Column="1" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="最大缩放" Style="{StaticResource EditorFieldLabelStyle}" />
                                            <TextBox x:Name="ScaleMaxText" Grid.Row="1" Grid.Column="1" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="缩放步长" Style="{StaticResource EditorFieldLabelStyle}" />
                                            <ComboBox x:Name="ScaleStepText" Grid.Row="2" Grid.Column="1" IsEditable="True" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel x:Name="DeformablePanel" Margin="0,12,0,0">
                                        <TextBlock Text="局部变形参数" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="行缩放最小" Style="{StaticResource EditorFieldLabelStyle}" />
                                            <TextBox x:Name="ScaleRowMinText" Grid.Row="0" Grid.Column="1" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="行缩放最大" Style="{StaticResource EditorFieldLabelStyle}" />
                                            <TextBox x:Name="ScaleRowMaxText" Grid.Row="1" Grid.Column="1" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="行缩放步长" Style="{StaticResource EditorFieldLabelStyle}" />
                                            <ComboBox x:Name="ScaleRowStepText" Grid.Row="2" Grid.Column="1" IsEditable="True" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="列缩放最小" Style="{StaticResource EditorFieldLabelStyle}" />
                                            <TextBox x:Name="ScaleColumnMinText" Grid.Row="3" Grid.Column="1" />
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="列缩放最大" Style="{StaticResource EditorFieldLabelStyle}" />
                                            <TextBox x:Name="ScaleColumnMaxText" Grid.Row="4" Grid.Column="1" />
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="列缩放步长" Style="{StaticResource EditorFieldLabelStyle}" />
                                            <ComboBox x:Name="ScaleColumnStepText" Grid.Row="5" Grid.Column="1" IsEditable="True" />
                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="平滑" Style="{StaticResource EditorFieldLabelStyle}" />
                                            <ComboBox x:Name="DeformationSmoothnessText" Grid.Row="6" Grid.Column="1" IsEditable="True" />
                                        </Grid>
                                    </StackPanel>
                                    <Button Content="创建模板" Margin="0,12,0,0" HorizontalAlignment="Right" Click="CreateTemplate_Click" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="ModelOriginCard" Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="模型原点" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="原点行偏移" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="ModelOriginRowText" Grid.Row="0" Grid.Column="1" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="原点列偏移" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="ModelOriginColumnText" Grid.Row="1" Grid.Column="1" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="在图像上点选原点" Margin="0,0,8,0" Click="PickOrigin_Click" />
                                        <Button Content="应用原点" Click="ApplyOrigin_Click" />
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="原点是相对模板参考点（图像 ROI 为区域重心，XLD 为轮廓外接矩形中心）的偏移，写入模型后匹配输出的 Row / Column 即为该点。点选：按下后可拖动，松开结束。" />
                                    <TextBlock x:Name="OriginBaseHintText" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Text="模型原点已修改：请重新确定跟随基准（基准 Row / Col / 角），基准不会随原点自动换算。" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="基准姿态" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="基准 Row" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="BaseRowText" Grid.Row="0" Grid.Column="1" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="基准 Col" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="BaseColumnText" Grid.Row="1" Grid.Column="1" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="基准角" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="BaseAngleText" Grid.Row="2" Grid.Column="1" />
                                    </Grid>
                                    <Button Content="选中结果设为基准" HorizontalAlignment="Right" Click="SetSelectedBase_Click" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorCardStyle}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="示教测试结果" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <DataGrid x:Name="TeachResultGrid" Height="170" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="56" />
                                            <DataGridTextColumn Header="Row" Binding="{Binding Row}" Width="*" />
                                            <DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="*" />
                                            <DataGridTextColumn Header="Angle" Binding="{Binding Angle}" Width="*" />
                                            <DataGridTextColumn Header="Scale" Binding="{Binding Scale}" Width="*" />
                                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="运行参数">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="运行预览" Style="{StaticResource EditorSectionTitleStyle}" />
                            <wfi:WindowsFormsHost>
                                <vfc:HalconImageView x:Name="RunImageView" />
                            </wfi:WindowsFormsHost>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="输入与模型" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="模块名" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="ModuleNameText" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="图像输入" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="ImagePathCombo" Grid.Row="1" Grid.Column="1" IsEditable="True" SelectionChanged="ImagePathCombo_SelectionChanged" />
                                        <Button Grid.Row="1" Grid.Column="2" Content="..." MinWidth="32" Width="32" Padding="0" Click="BrowseImage_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="查找参数" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="起始角" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="FindStartAngleText" Grid.Row="0" Grid.Column="1" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="角范围" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="FindExtentAngleText" Grid.Row="1" Grid.Column="1" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="最小分" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="MinScoreText" Grid.Row="2" Grid.Column="1" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="数量" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="NumMatchesText" Grid.Row="3" Grid.Column="1" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="重叠" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="MaxOverlapText" Grid.Row="4" Grid.Column="1" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="贪婪度" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="GreedinessText" Grid.Row="5" Grid.Column="1" />
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="亚像素" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="SubPixelCombo" Grid.Row="6" Grid.Column="1" />
                                        <CheckBox x:Name="FailWhenNotFoundCheck" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                                                  Margin="0,12,0,0"
                                                  Content="未匹配到目标时失败（取消后输出 Found=false 并继续）" />
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="搜索区域" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="SearchRegionCombo" Grid.Row="0" Grid.Column="1" IsEditable="True" />
                                        <TextBlock x:Name="SearchRegionHintText" Grid.Row="1" Grid.Column="1" Margin="0,4,0,8" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="可选，留空则在整幅图像中查找。搜索区域限制的是模型参考点（示教区域的重心）落在区域内，不是整个模板落在区域内。" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="排序方式" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="SortByCombo" Grid.Row="2" Grid.Column="1" SelectionChanged="SortByCombo_SelectionChanged" />
                                        <TextBlock x:Name="RowToleranceLabel" Grid.Row="3" Grid.Column="0" Text="行容差" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="RowToleranceText" Grid.Row="3" Grid.Column="1"
                                                 ToolTip="行差不超过该值（像素）的结果视为同一行，同一行内按列排序；0 表示不分行" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="排序只改变结果数组（Items / Scores / HomMats / Contours）的顺序；最佳结果与 Row / Column / Angle / Score 始终取得分最高的一项。" />
                                    </Grid>
                                    <Button Content="执行测试" Margin="0,12,0,0" HorizontalAlignment="Right" Click="TestRun_Click" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorCardStyle}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="运行测试结果" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <DataGrid x:Name="RunResultGrid" Height="220" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="56" />
                                            <DataGridTextColumn Header="Row" Binding="{Binding Row}" Width="*" />
                                            <DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="*" />
                                            <DataGridTextColumn Header="Angle" Binding="{Binding Angle}" Width="*" />
                                            <DataGridTextColumn Header="Scale" Binding="{Binding Scale}" Width="*" />
                                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button DockPanel.Dock="Right" Content="取消" MinWidth="96" Margin="8,0,0,0" Click="Cancel_Click" />
            <Button DockPanel.Dock="Right" Content="确定" MinWidth="96" Style="{StaticResource AccentButtonStyle}" Click="Ok_Click" />
        </DockPanel>
    </Grid>
</Window>
