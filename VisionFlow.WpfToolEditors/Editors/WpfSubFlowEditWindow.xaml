<Window x:Class="VisionFlow.WpfToolEditors.Editors.WpfSubFlowEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="子流程"
        Width="1180"
        Height="760"
        MinWidth="1000"
        MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="480" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
            <Border DockPanel.Dock="Top" Style="{StaticResource EditorCardStyle}">
                <StackPanel>
                    <TextBlock Text="子流程文件" Style="{StaticResource EditorSectionTitleStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FlowFileText" Height="32" VerticalContentAlignment="Center"
                                 LostFocus="FlowFileText_LostFocus" KeyDown="FlowFileText_KeyDown" />
                        <Button Grid.Column="1" Content="选择文件..." MinWidth="96" Margin="8,0,0,0" Click="Browse_Click" />
                    </Grid>
                    <TextBlock x:Name="ResolvedPathText" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="LoadStatusText" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource EditorCardStyle}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="输入映射" Style="{StaticResource EditorSectionTitleStyle}" />
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="子流程默认沿用当前流程的 Input.* 外部输入（如 Input.Image）；在此追加或覆盖，例如把 Input.Threshold 设为 ref:计算1.阈值。取值为引用（ref:模块.变量）或常量。" />
                    <Button DockPanel.Dock="Bottom" Content="添加输入映射" HorizontalAlignment="Left" MinWidth="120" Margin="0,10,0,0" Click="AddInput_Click" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="InputsPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource EditorCardStyle}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock Text="输出（子流程顶层的流程输出）" Style="{StaticResource EditorSectionTitleStyle}" Margin="0" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="试运行" MinWidth="96" Click="RunPreview_Click" />
                    </DockPanel>
                    <DataGrid x:Name="OutputsGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="26" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="引用路径" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="90" />
                            <DataGridTextColumn Header="试运行结果" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource EditorCardStyle}" Margin="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock Text="校验" Style="{StaticResource EditorSectionTitleStyle}" Margin="0" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="重新校验" MinWidth="96" Click="Validate_Click" />
                    </DockPanel>
                    <ListBox x:Name="IssuesList" />
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" LastChildFill="False" Margin="0,24,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="760"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button DockPanel.Dock="Right" Content="取消" MinWidth="96" Margin="8,0,0,0" Click="Cancel_Click" />
            <Button DockPanel.Dock="Right" Content="确定" MinWidth="96" Style="{StaticResource AccentButtonStyle}" Click="Ok_Click" />
        </DockPanel>
    </Grid>
</Window>
