<Window x:Class="VisionFlow.WpfToolEditors.Editors.WpfFollowMeasureToolEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VisionFlow.WpfToolEditors.Controls"
        Title="测量编辑"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl TabStripPlacement="Right">
            <TabItem Header="示教">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource EditorCardStyle}">
                        <controls:WpfRoiEditorControl x:Name="TeachRoiEditor" />
                    </Border>
                    <ScrollViewer Grid.Column="1" Margin="24,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="示教设置" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <TextBlock Text="模块名" Style="{StaticResource EditorFieldLabelStyle}" />
                                    <TextBox x:Name="ModuleNameText" />
                                    <TextBlock Text="示教图像" Style="{StaticResource EditorFieldLabelStyle}" />
                                    <ComboBox x:Name="ImagePathCombo" IsEditable="True" SelectionChanged="ImagePathCombo_SelectionChanged" />
                                    <TextBlock Text="示教模式" Style="{StaticResource EditorFieldLabelStyle}" />
                                    <ComboBox x:Name="TeachModeCombo" SelectionChanged="TeachModeCombo_SelectionChanged" />
                                    <TextBlock Text="当前姿态" Style="{StaticResource EditorFieldLabelStyle}" />
                                    <ComboBox x:Name="TeachPosePathCombo" IsEditable="True" SelectionChanged="TeachPosePathCombo_SelectionChanged" />
                                    <Button x:Name="DrawRoiButton" Margin="0,8,0,16" Click="DrawRoi_Click" />
                                    <Button Content="保存示教基准" Style="{StaticResource AccentButtonStyle}" Click="SaveTeach_Click" />
                                    <TextBlock Text="基准图像示教会直接保存 ROI；当前图像示教会使用当前姿态的逆矩阵反算回基准 ROI。"
                                               Margin="0,16,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel x:Name="RunSettingsPanel">
                                    <TextBlock Text="运行/卡尺设置" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <TextBlock Text="运行跟随矩阵" Style="{StaticResource EditorFieldLabelStyle}" />
                                    <ComboBox x:Name="MatrixPathCombo" IsEditable="True" />
                                    <TextBlock x:Name="InitRegionLabel" Text="初始区域（按区域形状直接测量，配置后不使用示教基准与跟随矩阵）"
                                               TextWrapping="Wrap" Style="{StaticResource EditorFieldLabelStyle}" />
                                    <ComboBox x:Name="InitRegionPathCombo" IsEditable="True" />
                                    <TextBlock Text="结果序号" Style="{StaticResource EditorFieldLabelStyle}" />
                                    <ComboBox x:Name="IndexPathCombo" IsEditable="True" />
                                    <TextBlock Text="卡尺长度1" Style="{StaticResource EditorFieldLabelStyle}" />
                                    <controls:NumericInputControl x:Name="MeasureLength1Text" Minimum="0.1" Maximum="500" Increment="1" DecimalPlaces="2" ValueChanged="MeasureParameter_ValueChanged" />
                                    <TextBlock Text="卡尺长度2" Style="{StaticResource EditorFieldLabelStyle}" />
                                    <controls:NumericInputControl x:Name="MeasureLength2Text" Minimum="0.1" Maximum="500" Increment="1" DecimalPlaces="2" ValueChanged="MeasureParameter_ValueChanged" />
                                    <TextBlock Text="平滑 Sigma" Style="{StaticResource EditorFieldLabelStyle}" />
                                    <controls:NumericInputControl x:Name="MeasureSigmaText" Minimum="0" Maximum="100" Increment="0.1" DecimalPlaces="2" />
                                    <TextBlock Text="边缘阈值" Style="{StaticResource EditorFieldLabelStyle}" />
                                    <controls:NumericInputControl x:Name="MeasureThresholdText" Minimum="0" Maximum="255" Increment="1" DecimalPlaces="2" />
                                    <TextBlock Text="边缘极性" Style="{StaticResource EditorFieldLabelStyle}" />
                                    <ComboBox x:Name="TransitionCombo" IsEditable="True" />
                                    <TextBlock Text="边缘选择" Style="{StaticResource EditorFieldLabelStyle}" />
                                    <ComboBox x:Name="SelectCombo" IsEditable="True" />
                                    <ContentControl x:Name="AdvancedHost" />
                                    <StackPanel x:Name="ArcSettingsPanel" />
                                    <CheckBox x:Name="FailWhenNotFoundCheck" Margin="0,12,0,0"
                                              Content="未找到边缘时失败（取消后输出 Found=false 并继续）" />
                                    <Button Content="执行测试" Style="{StaticResource AccentButtonStyle}" Margin="0,16,0,0" Click="RunTest_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="运行">
                <Border Style="{StaticResource EditorCardStyle}">
                    <DataGrid x:Name="ResultGrid"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False" />
                </Border>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,24,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button DockPanel.Dock="Right" Content="取消" MinWidth="96" Margin="8,0,0,0" Click="Cancel_Click" />
            <Button DockPanel.Dock="Right" Content="确定" MinWidth="96" Style="{StaticResource AccentButtonStyle}" Click="Ok_Click" />
        </DockPanel>
    </Grid>
</Window>
