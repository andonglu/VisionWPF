<Window x:Class="VisionFlow.WpfToolEditors.Editors.WpfColorSegmentToolEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:vfc="clr-namespace:VisionFlow.Controls;assembly=VisionFlow.Controls"
        Title="颜色分割"
        Width="1280"
        Height="900"
        MinWidth="1080"
        MinHeight="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,16">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="图像（彩色框为各类样本区域）" Style="{StaticResource EditorSectionTitleStyle}" />
                        <Button x:Name="SampleButton" Grid.Column="1" Content="框选样本" Margin="8,0,0,0" Click="Sample_Click" />
                        <Button x:Name="ClearSampleButton" Grid.Column="2" Content="清除该类样本" Margin="8,0,0,0" Click="ClearSample_Click" />
                        <Button x:Name="TrainButton" Grid.Column="3" Content="训练" Margin="8,0,0,0" Click="Train_Click" />
                        <Button Grid.Column="4" Content="执行测试" Margin="8,0,0,0" Click="TestRun_Click" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock x:Name="TrainInfoText" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                    <wfi:WindowsFormsHost>
                        <vfc:HalconImageView x:Name="PreviewImageView" />
                    </wfi:WindowsFormsHost>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="颜色类（训练 / 分割结果按类显示，训练后执行测试可预览分割叠加）"
                               Style="{StaticResource EditorSectionTitleStyle}" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="添加类" Click="AddClass_Click" />
                        <Button Content="删除类" Margin="8,0,0,0" Click="RemoveClass_Click" />
                    </StackPanel>
                    <ListView x:Name="ClassList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="颜色" Width="54">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="24" Height="14" CornerRadius="2" BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                                    BorderThickness="1" Background="{Binding SwatchBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="类名" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="样本" DisplayMemberBinding="{Binding SampleText}" Width="70" />
                                <GridViewColumn Header="面积" DisplayMemberBinding="{Binding AreaText}" Width="90" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="输入" Style="{StaticResource EditorSectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="模块名" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="ModuleNameText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="图像" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="ImagePathCombo" Grid.Row="1" Grid.Column="1" IsEditable="True" Margin="0,0,0,8" SelectionChanged="ImagePathCombo_SelectionChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="分割参数" Style="{StaticResource EditorSectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Classifier" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="ClassifierCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="RejectionThreshold" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="RejectionThresholdText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
                            <CheckBox x:Name="FailWhenNotFoundCheck" Grid.Row="2" Grid.Column="1" Content="FailWhenNotFound（全空时失败）" Margin="0,4,0,0" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="为每个类在图像上框选样本区域（各类一个），全部类都有样本后点“训练”：训练结果随“确定”保存到工具。拒识阈值 0~1（含 0、不含 1），越大越严格；训练后“执行测试”在图上按类显示分割结果（拒识区域灰色）。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" LastChildFill="False" Margin="0,24,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="900"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button DockPanel.Dock="Right" Content="取消" MinWidth="96" Margin="8,0,0,0" Click="Cancel_Click" />
            <Button DockPanel.Dock="Right" Content="确定" MinWidth="96" Style="{StaticResource AccentButtonStyle}" Click="Ok_Click" />
        </DockPanel>
    </Grid>
</Window>
