<Window x:Class="VisionFlow.WpfToolEditors.Editors.WpfImageRectifyToolEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:vfc="clr-namespace:VisionFlow.Controls;assembly=VisionFlow.Controls"
        Title="畸变校正"
        Width="1240"
        Height="840"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,12,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="图像预览" Style="{StaticResource EditorSectionTitleStyle}" />
                    <ComboBox x:Name="PreviewCombo" Grid.Column="1" SelectionChanged="PreviewCombo_SelectionChanged" />
                </Grid>
                <TextBlock x:Name="ResultSummaryText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                <wfi:WindowsFormsHost>
                    <vfc:HalconImageView x:Name="PreviewImageView" />
                </wfi:WindowsFormsHost>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="输入" Style="{StaticResource EditorSectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="模块名" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="ModuleNameText" Grid.Row="0" Grid.Column="1" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="图像" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="ImagePathCombo" Grid.Row="1" Grid.Column="1" IsEditable="True" SelectionChanged="ImagePathCombo_SelectionChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="相机标定" Style="{StaticResource EditorSectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="标定来源" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="SourceCombo" Grid.Row="0" Grid.Column="1" SelectionChanged="SourceCombo_SelectionChanged" />
                            <TextBlock x:Name="CalibrationFileLabel" Grid.Row="1" Grid.Column="0" Text="标定文件" Style="{StaticResource EditorFieldLabelStyle}" />
                            <Grid x:Name="CalibrationFilePanel" Grid.Row="1" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CalibrationFileText" Grid.Column="0" LostFocus="CalibrationFileText_LostFocus" />
                                <Button Grid.Column="1" Content="..." MinWidth="32" Width="32" Padding="0" Click="BrowseCalibrationFile_Click" />
                            </Grid>
                        </Grid>
                        <Button x:Name="EmbedFileButton" Content="把标定文件内嵌到工具" Margin="0,8,0,0" HorizontalAlignment="Right" Click="EmbedFile_Click" />
                        <TextBlock x:Name="CalibrationInfoText" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="需要带 Camera 段的 .vfcal.json（在“图像坐标转世界坐标”的相机标定页生成）；像素当量与输出区域使用标定文件的单位。文件与内嵌互斥。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="校正输出" Style="{StaticResource EditorSectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="像素当量（0 = 自动）" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="PixelSizeText" Grid.Row="0" Grid.Column="1" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="区域左上 X" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="RegionXText" Grid.Row="1" Grid.Column="1" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="区域左上 Y" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="RegionYText" Grid.Row="2" Grid.Column="1" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="区域宽（0 = 整个视野）" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="RegionWidthText" Grid.Row="3" Grid.Column="1" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="区域高（0 = 整个视野）" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="RegionHeightText" Grid.Row="4" Grid.Column="1" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="插值" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="InterpolationCombo" Grid.Row="5" Grid.Column="1" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="输出区域为测量平面坐标（X 沿校正图列方向，Y 沿行方向）。输出 Matrix 把校正图的 (行, 列) 换算为物理 (X, Y)，可直接给“图像坐标转世界坐标”的变换矩阵引用。" />
                        <Button Content="执行测试" Margin="0,12,0,0" HorizontalAlignment="Right" Click="TestRun_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" LastChildFill="False" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="900"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button DockPanel.Dock="Right" Content="取消" MinWidth="96" Margin="8,0,0,0" Click="Cancel_Click" />
            <Button DockPanel.Dock="Right" Content="确定" MinWidth="96" Style="{StaticResource AccentButtonStyle}" Click="Ok_Click" />
        </DockPanel>
    </Grid>
</Window>
