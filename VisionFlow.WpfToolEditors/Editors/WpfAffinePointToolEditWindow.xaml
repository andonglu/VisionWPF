<Window x:Class="VisionFlow.WpfToolEditors.Editors.WpfAffinePointToolEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:vfc="clr-namespace:VisionFlow.Controls;assembly=VisionFlow.Controls"
        Title="图像坐标转世界坐标"
        Width="1320"
        Height="880"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0">
            <TabItem x:Name="RunTab" Header="运行参数">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="测试结果" Style="{StaticResource EditorSectionTitleStyle}" />
                            <TextBlock x:Name="RunSummaryText" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <DataGrid x:Name="RunResultGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="60" />
                                    <DataGridTextColumn Header="WorldRow" Binding="{Binding WorldRow}" Width="*" />
                                    <DataGridTextColumn Header="WorldColumn" Binding="{Binding WorldColumn}" Width="*" />
                                    <DataGridTextColumn Header="WorldAngle" Binding="{Binding WorldAngle}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="输入" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="模块名" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="ModuleNameText" Grid.Row="0" Grid.Column="1" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Row" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="RowPathCombo" Grid.Row="1" Grid.Column="1" IsEditable="True" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Column" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="ColumnPathCombo" Grid.Row="2" Grid.Column="1" IsEditable="True" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="角度" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="AnglePathCombo" Grid.Row="3" Grid.Column="1" IsEditable="True" />
                                        <TextBlock x:Name="MatrixPathLabel" Grid.Row="4" Grid.Column="0" Text="变换矩阵" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="MatrixPathCombo" Grid.Row="4" Grid.Column="1" IsEditable="True" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="Row / Column / 角度可为单值或数组（个数相等逐一对应，一侧为 1 个时一对多）；角度为弧度，可选。引用变换矩阵时（仅仿射矩阵方式）优先使用该矩阵。" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="标定" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="标定方式" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="KindCombo" Grid.Row="0" Grid.Column="1" SelectionChanged="KindCombo_SelectionChanged" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="标定来源" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="SourceCombo" Grid.Row="1" Grid.Column="1" SelectionChanged="SourceCombo_SelectionChanged" />
                                        <TextBlock x:Name="CalibrationFileLabel" Grid.Row="2" Grid.Column="0" Text="标定文件" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <Grid x:Name="CalibrationFilePanel" Grid.Row="2" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CalibrationFileText" Grid.Column="0" LostFocus="CalibrationFileText_LostFocus" />
                                            <Button Grid.Column="1" Content="..." MinWidth="32" Width="32" Padding="0" Click="BrowseCalibrationFile_Click" />
                                        </Grid>
                                    </Grid>
                                    <TextBlock x:Name="CalibrationInfoText" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="标定文件为 .vfcal.json（旧版 write_tuple 矩阵文件按内容自动识别，继续可用）；内嵌时标定内容随流程文件保存。切换来源会清空另一侧。" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="原点偏移" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="OriginRow" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="OriginRowText" Grid.Row="0" Grid.Column="1" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="OriginColumn" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="OriginColumnText" Grid.Row="1" Grid.Column="1" />
                                    </Grid>
                                    <Button Content="执行测试" Margin="0,12,0,0" HorizontalAlignment="Right" Click="TestRun_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="AssistantTab" Header="N 点标定">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="540" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,12,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="标定图像" Style="{StaticResource EditorSectionTitleStyle}" />
                                <ComboBox x:Name="CalibImageCombo" Grid.Column="1" IsEditable="True" SelectionChanged="CalibImageCombo_SelectionChanged" />
                            </Grid>
                            <TextBlock x:Name="PickHintText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="十字为点对表中的图像点；点击“在图像上点击取点”后，在图像上按下鼠标即加入一个点（按住拖动可微调）。" />
                            <wfi:WindowsFormsHost>
                                <vfc:HalconImageView x:Name="CalibImageView" />
                            </wfi:WindowsFormsHost>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="采集点对" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="行变量" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="PickRowVarCombo" Grid.Row="0" Grid.Column="1" IsEditable="True" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="列变量" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="PickColumnVarCombo" Grid.Row="1" Grid.Column="1" IsEditable="True" />
                                    </Grid>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="取当前值" Margin="0,0,8,8" Click="TakeCurrentValue_Click" />
                                        <Button Content="在图像上点击取点" Margin="0,0,8,8" Click="PickOnImage_Click" />
                                    </WrapPanel>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="图像行" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="图像列" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="物理 X" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="物理 Y" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="ManualRowText" Grid.Row="1" Grid.Column="0" Margin="0,0,4,0" />
                                        <TextBox x:Name="ManualColumnText" Grid.Row="1" Grid.Column="1" Margin="0,0,4,0" />
                                        <TextBox x:Name="ManualXText" Grid.Row="1" Grid.Column="2" Margin="0,0,4,0" />
                                        <TextBox x:Name="ManualYText" Grid.Row="1" Grid.Column="3" />
                                    </Grid>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="手动添加点" Margin="0,0,8,8" Click="AddManualPoint_Click" />
                                        <Button Content="导入物理坐标 CSV…" Margin="0,0,8,8" Click="ImportCsv_Click" />
                                    </WrapPanel>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="取当前值要求引用单值（数组请引用元素，如 匹配1.Rows[0]）。物理坐标可在表格中直接修改；CSV 每行“X,Y”依次写入各点（“序号,X,Y”同样可用），“行,列,X,Y”四列时整行导入。" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="点对" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <DataGrid x:Name="PointGrid" Height="250" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                              CanUserSortColumns="False" SelectionMode="Single" CellEditEnding="PointGrid_CellEditEnding">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutlier}" Value="True">
                                                        <Setter Property="Background" Value="#FDE7E9" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="56" IsReadOnly="True" />
                                            <!-- 显示按位数格式化；编辑框绑定原值，避免未改动就提交时把数值截成显示位数 -->
                                            <DataGridTemplateColumn Header="图像行" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Row, StringFormat=F3}" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate><TextBox Text="{Binding Row, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="图像列" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Column, StringFormat=F3}" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate><TextBox Text="{Binding Column, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="物理 X" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding X, StringFormat=F4}" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate><TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="物理 Y" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Y, StringFormat=F4}" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate><TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="残差" Binding="{Binding ResidualText}" Width="*" IsReadOnly="True" />
                                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="64" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="删除选中点" Margin="0,0,8,8" Click="DeletePoint_Click" />
                                        <Button Content="删除超阈点" Margin="0,0,8,8" Click="DeleteOutliers_Click" />
                                        <Button Content="清空" Margin="0,0,0,8" Click="ClearPoints_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="计算与保存" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="变换类型" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="TransformTypeCombo" Grid.Row="0" Grid.Column="1" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="残差阈值" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="ResidualThresholdText" Grid.Row="1" Grid.Column="1" Text="0.05" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="物理单位" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="UnitText" Grid.Row="2" Grid.Column="1" Text="mm" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="描述" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="DescriptionText" Grid.Row="3" Grid.Column="1" />
                                    </Grid>
                                    <Button Content="计算" Margin="0,12,0,0" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="Solve_Click" />
                                    <TextBlock x:Name="SolveResultText" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MatrixText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right">
                                        <Button Content="保存为标定文件…" Margin="0,0,8,0" Click="SaveCalibrationFile_Click" />
                                        <Button x:Name="EmbedButton" Content="内嵌到当前工具" Click="EmbedCalibration_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="RotationTab" Header="旋转中心">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="540" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,12,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="旋转图像" Style="{StaticResource EditorSectionTitleStyle}" />
                                <ComboBox x:Name="RotImageCombo" Grid.Column="1" IsEditable="True" SelectionChanged="RotImageCombo_SelectionChanged" />
                            </Grid>
                            <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="十字为各次旋转后特征点的位置，求解后圆为拟合的旋转轨迹。角度按图像角度约定（与匹配 Angle 相同，屏幕上逆时针为正）；机构角度方向相反时请取反。" />
                            <wfi:WindowsFormsHost>
                                <vfc:HalconImageView x:Name="RotImageView" />
                            </wfi:WindowsFormsHost>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="采集旋转点" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="行变量" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="RotRowVarCombo" Grid.Row="0" Grid.Column="1" IsEditable="True" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="列变量" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="RotColumnVarCombo" Grid.Row="1" Grid.Column="1" IsEditable="True" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="角度变量" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="RotAngleVarCombo" Grid.Row="2" Grid.Column="1" IsEditable="True" />
                                    </Grid>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="取当前值" Margin="0,0,8,8" Click="RotTakeCurrentValue_Click" />
                                        <Button Content="在图像上点击取点" Margin="0,0,8,8" Click="RotPickOnImage_Click" />
                                    </WrapPanel>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="图像行" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="图像列" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="角度（°，可空）" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="RotManualRowText" Grid.Row="1" Grid.Column="0" Margin="0,0,4,0" />
                                        <TextBox x:Name="RotManualColumnText" Grid.Row="1" Grid.Column="1" Margin="0,0,4,0" />
                                        <TextBox x:Name="RotManualAngleText" Grid.Row="1" Grid.Column="2" />
                                    </Grid>
                                    <Button Content="手动添加点" Margin="0,8,0,0" HorizontalAlignment="Left" Click="RotAddManualPoint_Click" />
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="至少 2 个带角度的点按角度求解（更准），否则至少 3 个点做圆拟合；建议覆盖 30° 以上。取当前值要求单值；角度变量按弧度读取（如匹配 Angle），可留空。" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="旋转点" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <DataGrid x:Name="RotPointGrid" Height="220" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                              CanUserSortColumns="False" SelectionMode="Single" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="56" />
                                            <DataGridTextColumn Header="图像行" Binding="{Binding Row, StringFormat=F3}" Width="*" />
                                            <DataGridTextColumn Header="图像列" Binding="{Binding Column, StringFormat=F3}" Width="*" />
                                            <DataGridTextColumn Header="角度（°）" Binding="{Binding AngleText}" Width="*" />
                                            <DataGridTextColumn Header="残差" Binding="{Binding ResidualText}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="删除选中点" Margin="0,0,8,8" Click="RotDeletePoint_Click" />
                                        <Button Content="清空" Margin="0,0,0,8" Click="RotClearPoints_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="求解与保存" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <Button Content="求解" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="RotSolve_Click" />
                                    <TextBlock x:Name="RotResultText" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <TextBlock x:Name="RotPhysicalText" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RotWarningText" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="当前标定带 Affine2D（N 点标定）时，结果与它合并成一个标定（同时供坐标转换与纠偏计算的 RotateAroundCenter 使用）；否则只保存旋转中心。" />
                                    <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right">
                                        <Button Content="保存为标定文件…" Margin="0,0,8,0" Click="RotSaveCalibrationFile_Click" />
                                        <Button x:Name="RotEmbedButton" Content="内嵌到当前工具" Click="RotEmbedCalibration_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="CameraTab" Header="相机标定">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="540" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="标定板图像（选中列表中的一张查看）" Style="{StaticResource EditorSectionTitleStyle}" />
                            <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="建议 10~20 张，标定板覆盖视野的不同位置并有不同倾斜角度；其中一张放在测量平面上作为参考图像（填写标定板厚度）。" />
                            <wfi:WindowsFormsHost>
                                <vfc:HalconImageView x:Name="CamImageView" />
                            </wfi:WindowsFormsHost>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="标定图像" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="当前图像" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="CamCurrentImageCombo" Grid.Column="1" IsEditable="True" />
                                    </Grid>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="从文件夹加入…" Margin="0,0,8,8" Click="CamAddFolder_Click" />
                                        <Button Content="加入当前图像" Margin="0,0,8,8" Click="CamAddCurrent_Click" />
                                        <Button Content="移除选中" Margin="0,0,8,8" Click="CamRemoveSelected_Click" />
                                        <Button Content="移除未找到" Margin="0,0,8,8" Click="CamRemoveNotFound_Click" />
                                        <Button Content="设为参考图像" Margin="0,0,0,8" Click="CamSetReference_Click" />
                                    </WrapPanel>
                                    <DataGrid x:Name="CamImageGrid" Height="220" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
                                              SelectionMode="Single" SelectionChanged="CamImageGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="56" />
                                            <DataGridTextColumn Header="图像" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="结果" Binding="{Binding State}" Width="*" />
                                            <DataGridTextColumn Header="误差" Binding="{Binding ErrorText}" Width="72" />
                                            <DataGridTextColumn Header="参考" Binding="{Binding ReferenceText}" Width="56" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="标定板与相机" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="标定板描述文件" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <Grid Grid.Row="0" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CamPlateText" Grid.Column="0" />
                                            <Button Grid.Column="1" Content="..." MinWidth="32" Width="32" Padding="0" Click="CamBrowsePlate_Click" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="相机模型" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <ComboBox x:Name="CamModelCombo" Grid.Row="1" Grid.Column="1" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="焦距（mm）" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="CamFocusText" Grid.Row="2" Grid.Column="1" Text="8" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="像元宽（µm）" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="CamCellWidthText" Grid.Row="3" Grid.Column="1" Text="3.7" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="像元高（µm）" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="CamCellHeightText" Grid.Row="4" Grid.Column="1" Text="3.7" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="主点列 cx" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="CamCxText" Grid.Row="5" Grid.Column="1" />
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="主点行 cy" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="CamCyText" Grid.Row="6" Grid.Column="1" />
                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="图像宽" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="CamWidthText" Grid.Row="7" Grid.Column="1" />
                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="图像高" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="CamHeightText" Grid.Row="8" Grid.Column="1" />
                                        <TextBlock Grid.Row="9" Grid.Column="0" Text="标定板厚度（mm）" Style="{StaticResource EditorFieldLabelStyle}" />
                                        <TextBox x:Name="CamThicknessText" Grid.Row="9" Grid.Column="1" Text="0" />
                                    </Grid>
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="加入第一张图像时自动填入图像宽高并把主点设为图像中心。厚度用于把参考图像的标定板位姿修正到它所放置的测量平面。" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource EditorCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="标定与保存" Style="{StaticResource EditorSectionTitleStyle}" />
                                    <Button Content="标定" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="CamCalibrate_Click" />
                                    <TextBlock x:Name="CamResultText" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CamParamsText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="保存 / 内嵌时与当前标定已有的 Affine2D、旋转中心段共存；只有相机标定时，坐标转换改为 Camera 方式。单位沿用 N 点标定页的“物理单位”。" />
                                    <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right">
                                        <Button Content="保存为标定文件…" Margin="0,0,8,0" Click="CamSaveCalibrationFile_Click" />
                                        <Button x:Name="CamEmbedButton" Content="内嵌到当前工具" Click="CamEmbedCalibration_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="900"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="取消" MinWidth="96" Margin="8,0,0,0" Click="Cancel_Click" />
            <Button x:Name="OkButton" DockPanel.Dock="Right" Content="确定" MinWidth="96" Style="{StaticResource AccentButtonStyle}" Click="Ok_Click" />
        </DockPanel>
    </Grid>
</Window>
