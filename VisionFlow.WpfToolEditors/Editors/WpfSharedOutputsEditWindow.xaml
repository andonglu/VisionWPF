<Window x:Class="VisionFlow.WpfToolEditors.Editors.WpfSharedOutputsEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="公共输出"
        Width="900"
        Height="680"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource EditorCardStyle}">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource EditorSectionTitleStyle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="公共输出把分支内部的结果统一交给分支之后的节点：每个输出在每个分支各给一个取值（引用写 ref:模块.变量，常量直接写数字、true/false 或文本）。分支内部的输出只能在本分支的取值中引用。" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RowsPanel" />
        </ScrollViewer>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,16,0,0">
            <Button Content="添加输出" MinWidth="96" Click="Add_Click" />
            <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button DockPanel.Dock="Right" Content="取消" MinWidth="96" Margin="8,0,0,0" Click="Cancel_Click" />
            <Button DockPanel.Dock="Right" Content="确定" MinWidth="96" Style="{StaticResource AccentButtonStyle}" Click="Ok_Click" />
        </DockPanel>
    </Grid>
</Window>
