<Window x:Class="VisionFlow.WpfToolEditors.Editors.WpfHalconExamplePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:vfc="clr-namespace:VisionFlow.Controls;assembly=VisionFlow.Controls"
        Title="HALCON 示例图像"
        Width="1080"
        Height="720"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource EditorCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="HALCON 示例图像" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="RootPathText"
                           Grid.Column="1"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="SearchText"
                         Grid.Column="2"
                         Margin="16,0,0,16"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchText_TextChanged" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource EditorCardStyle}" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="分组" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ListBox x:Name="GroupList" SelectionChanged="GroupList_SelectionChanged" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource EditorCardStyle}" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="图像" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ListBox x:Name="ImageList"
                             SelectionChanged="ImageList_SelectionChanged"
                             MouseDoubleClick="ImageList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding RelativePath}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="Black"
                        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <wfi:WindowsFormsHost>
                        <vfc:HalconImageView x:Name="PreviewImageView" />
                    </wfi:WindowsFormsHost>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource EditorCardStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SelectedNameText" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedPathText"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button DockPanel.Dock="Right"
                    Content="取消"
                    MinWidth="96"
                    Margin="8,0,0,0"
                    Click="Cancel_Click" />
            <Button DockPanel.Dock="Right"
                    Content="选择"
                    MinWidth="96"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Select_Click" />
        </DockPanel>
    </Grid>
</Window>
