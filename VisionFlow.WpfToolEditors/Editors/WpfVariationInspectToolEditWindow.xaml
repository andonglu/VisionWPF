<Window x:Class="VisionFlow.WpfToolEditors.Editors.WpfVariationInspectToolEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:vfc="clr-namespace:VisionFlow.Controls;assembly=VisionFlow.Controls"
        Title="差分检测编辑"
        Width="1280"
        Height="860"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,12,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="图像预览" Style="{StaticResource EditorSectionTitleStyle}" />
                    <ComboBox x:Name="PreviewCombo" Grid.Column="1" SelectionChanged="PreviewCombo_SelectionChanged" />
                </Grid>
                <TextBlock x:Name="PreviewInfoText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <wfi:WindowsFormsHost>
                    <vfc:HalconImageView x:Name="PreviewImageView" />
                </wfi:WindowsFormsHost>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="输入" Style="{StaticResource EditorSectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="模块名" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="ModuleNameText" Grid.Row="0" Grid.Column="1" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="图像输入" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="ImagePathCombo" Grid.Row="1" Grid.Column="1" IsEditable="True" SelectionChanged="ImagePathCombo_SelectionChanged" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="定位矩阵" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="MatrixPathCombo" Grid.Row="2" Grid.Column="1" IsEditable="True" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="检测区域" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="RegionPathCombo" Grid.Row="3" Grid.Column="1" IsEditable="True" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="定位矩阵与检测区域可选。矩阵为“示教位姿 → 当前位姿”（如模板匹配的 BestHomMat），当前图像按其逆矩阵对齐到模型位置后比较；检测区域在模型（对齐后）坐标中，区域为空时运行失败。" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="训练样本（仅本次编辑有效）" Style="{StaticResource EditorSectionTitleStyle}" />
                        <TextBlock x:Name="SampleCountText" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="加入当前图像" Margin="0,0,8,8" Click="AddCurrentSample_Click" />
                            <Button Content="批量加入文件夹…" Margin="0,0,8,8" Click="AddFolderSamples_Click" />
                            <Button Content="清空样本" Margin="0,0,0,8" Click="ClearSamples_Click" />
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="建模方式" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="ModelModeCombo" Grid.Column="1" SelectionChanged="ModelModeCombo_SelectionChanged" />
                        </Grid>
                        <Button Content="训练" Margin="0,8,0,0" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="Train_Click" />
                        <TextBlock x:Name="ModelInfoText" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="ModeMismatchText" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock x:Name="LargeModelHintText" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="模型存储" Style="{StaticResource EditorSectionTitleStyle}" />
                        <TextBlock Text="外部模型文件（为空则内嵌在流程文件中）" Style="{StaticResource EditorFieldLabelStyle}" />
                        <TextBox x:Name="ModelFileText" IsReadOnly="True" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="导出为外部文件…" Margin="0,0,8,8" Click="ExportModelFile_Click" />
                            <Button Content="选择外部文件…" Margin="0,0,8,8" Click="SelectModelFile_Click" />
                            <Button Content="改为内嵌" Margin="0,0,0,8" Click="EmbedModel_Click" />
                        </WrapPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="外部文件与内嵌数据互斥：使用外部文件时清空内嵌数据，运行时从文件加载；重新训练会清空外部文件配置，改用内嵌的新模型。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="检测参数" Style="{StaticResource EditorSectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="绝对阈值" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="AbsThresholdText" Grid.Row="0" Grid.Column="1" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="相对阈值" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="VarThresholdText" Grid.Row="1" Grid.Column="1" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,8" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="1 个值亮暗共用（如 20），或“亮,暗”两个值（如 20,30）。允许偏差 = max(绝对阈值, 相对阈值 × 偏差图)；修改阈值不需要重新训练。" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="比较方式" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="CompareModeCombo" Grid.Row="3" Grid.Column="1" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="最小缺陷面积" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="MinDefectAreaText" Grid.Row="4" Grid.Column="1" />
                        </Grid>
                        <Button Content="执行测试" Margin="0,12,0,0" HorizontalAlignment="Right" Click="TestRun_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="检测结果" Style="{StaticResource EditorSectionTitleStyle}" />
                        <TextBlock x:Name="ResultSummaryText" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <DataGrid x:Name="DefectGrid" Height="180" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="60" />
                                <DataGridTextColumn Header="面积" Binding="{Binding Area}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" LastChildFill="False" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="900"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button DockPanel.Dock="Right" Content="取消" MinWidth="96" Margin="8,0,0,0" Click="Cancel_Click" />
            <Button DockPanel.Dock="Right" Content="确定" MinWidth="96" Style="{StaticResource AccentButtonStyle}" Click="Ok_Click" />
        </DockPanel>
    </Grid>
</Window>
