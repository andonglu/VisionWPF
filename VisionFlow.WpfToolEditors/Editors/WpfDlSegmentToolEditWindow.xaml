<Window x:Class="VisionFlow.WpfToolEditors.Editors.WpfDlSegmentToolEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:vfc="clr-namespace:VisionFlow.Controls;assembly=VisionFlow.Controls"
        Title="深度学习分割"
        Width="1280"
        Height="900"
        MinWidth="1080"
        MinHeight="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,16">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="图像（彩色叠加为各类分割区域，灰色为拒识）" Style="{StaticResource EditorSectionTitleStyle}" />
                        <Button Grid.Column="1" Content="取当前图像" Margin="8,0,0,0" Click="UseCurrentImage_Click" />
                        <Button Grid.Column="2" Content="加载图像..." Margin="8,0,0,0" Click="LoadImage_Click" />
                        <Button Grid.Column="3" Content="执行测试" Margin="8,0,0,0" Click="TestRun_Click" />
                    </Grid>
                    <TextBlock x:Name="ImageInfoText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <wfi:WindowsFormsHost>
                        <vfc:HalconImageView x:Name="PreviewImageView" />
                    </wfi:WindowsFormsHost>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="分割结果（每类一个区域，按模型类别序）" Style="{StaticResource EditorSectionTitleStyle}" Margin="0,0,0,8" />
                    <TextBlock x:Name="SummaryText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <ListView x:Name="ResultList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="序号" DisplayMemberBinding="{Binding Index}" Width="48" />
                                <GridViewColumn Header="类别" DisplayMemberBinding="{Binding ClassName}" Width="200" />
                                <GridViewColumn Header="类别ID" DisplayMemberBinding="{Binding ClassId}" Width="70" />
                                <GridViewColumn Header="面积(像素)" DisplayMemberBinding="{Binding Area}" Width="100" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="输入" Style="{StaticResource EditorSectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="模块名" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="ModuleNameText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="图像" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="ImagePathCombo" Grid.Row="1" Grid.Column="1" IsEditable="True" Margin="0,0,0,8" SelectionChanged="ImagePathCombo_SelectionChanged" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="ROI 区域" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="RegionPathCombo" Grid.Row="2" Grid.Column="1" IsEditable="True" Margin="0,0,0,8" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="ROI 区域可选：配置后先裁剪 ROI 再推理，分割区域自动缩放并映射回原图（引用上游的区域输出）。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="模型参数" Style="{StaticResource EditorSectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="模型文件" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="ModelFilePathText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />
                            <Button Grid.Row="0" Grid.Column="2" Content="浏览..." Margin="8,0,0,8" Click="BrowseModel_Click" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="设备" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="DeviceCombo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="BatchSize" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="BatchSizeText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="模型缓存" Style="{StaticResource EditorFieldLabelStyle}" />
                            <ComboBox x:Name="ModelCacheModeCombo" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="模型缓存：Instance 每工具实例一份句柄；Flow 同一流程共享一份；Project 整个进程共享一份（省显存、共享时推理串行）。模型文件支持环境变量与相对路径。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="分割参数" Style="{StaticResource EditorSectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="MinScore" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="MinScoreText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ClassFilter" Style="{StaticResource EditorFieldLabelStyle}" />
                            <TextBox x:Name="ClassFilterText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
                            <CheckBox x:Name="OptimizeForInferenceCheck" Grid.Row="2" Grid.Column="1" Content="OptimizeForInference（推理态优化）" Margin="0,4,0,8" />
                            <CheckBox x:Name="FailWhenNotFoundCheck" Grid.Row="3" Grid.Column="1" Content="FailWhenNotFound（全部类为空时失败）" Margin="0,4,0,0" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="MinScore 为像素置信度阈值（0~1，默认 0.5）：类区域内像素置信均值低于该值的类整类丢弃，保留类只输出 confidence ≥ MinScore 的像素。ClassFilter 可选：逗号分隔的类别名，限定输出的类别，留空表示全部类别。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" LastChildFill="False" Margin="0,24,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="900"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button DockPanel.Dock="Right" Content="取消" MinWidth="96" Margin="8,0,0,0" Click="Cancel_Click" />
            <Button DockPanel.Dock="Right" Content="确定" MinWidth="96" Style="{StaticResource AccentButtonStyle}" Click="Ok_Click" />
        </DockPanel>
    </Grid>
</Window>
