<UserControl x:Class="VisionFlow.WpfToolEditors.Controls.WpfRoiEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             xmlns:vfc="clr-namespace:VisionFlow.Controls;assembly=VisionFlow.Controls">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top"
                 Padding="8"
                 Background="{DynamicResource SurfaceBrush}">
            <Button ToolTip="打开图像" Style="{DynamicResource ToolBarIconButtonStyle}" Click="OpenImage_Click">
                <Viewbox Width="18" Height="18">
                    <Path Data="M3,5 L21,5 L21,19 L3,19 Z M5,17 L10,12 L13,15 L15,13 L20,18 M16,8 L18,8 L18,10 L16,10 Z"
                          Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" />
                </Viewbox>
            </Button>
            <Button ToolTip="适应窗口" Style="{DynamicResource ToolBarIconButtonStyle}" Click="Fit_Click">
                <Viewbox Width="18" Height="18">
                    <Path Data="M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15 M8,12 L16,12 M12,8 L12,16"
                          Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" />
                </Viewbox>
            </Button>

            <Separator />

            <Button ToolTip="绘制矩形 ROI" Style="{DynamicResource ToolBarIconButtonStyle}" Click="Rectangle_Click">
                <Viewbox Width="18" Height="18">
                    <Path Data="M5,6 L19,6 L19,18 L5,18 Z"
                          Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" />
                </Viewbox>
            </Button>
            <Button ToolTip="绘制旋转矩形 ROI" Style="{DynamicResource ToolBarIconButtonStyle}" Click="Rectangle2_Click">
                <Viewbox Width="18" Height="18">
                    <Path Data="M7,10 L16,5 L21,14 L12,19 Z M16,5 L18,3"
                          Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" />
                </Viewbox>
            </Button>
            <Button ToolTip="绘制圆 ROI" Style="{DynamicResource ToolBarIconButtonStyle}" Click="Circle_Click">
                <Viewbox Width="18" Height="18">
                    <Path Data="M12,4 C16,4 20,8 20,12 C20,16 16,20 12,20 C8,20 4,16 4,12 C4,8 8,4 12,4 Z"
                          Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" />
                </Viewbox>
            </Button>
            <Button ToolTip="绘制线 ROI" Style="{DynamicResource ToolBarIconButtonStyle}" Click="Line_Click">
                <Viewbox Width="18" Height="18">
                    <Path Data="M5,18 L19,6 M5,18 L9,18 M5,18 L5,14 M19,6 L15,6 M19,6 L19,10"
                          Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" />
                </Viewbox>
            </Button>

            <Separator />

            <Button ToolTip="设为包含区域" Style="{DynamicResource ToolBarIconButtonStyle}" Click="Include_Click">
                <Viewbox Width="18" Height="18">
                    <Path Data="M5,12 L10,17 L19,7"
                          Stroke="{DynamicResource SystemFillColorSuccessBrush}" StrokeThickness="2.2" StrokeLineJoin="Round" Fill="Transparent" />
                </Viewbox>
            </Button>
            <Button ToolTip="设为排除区域" Style="{DynamicResource ToolBarIconButtonStyle}" Click="Exclude_Click">
                <Viewbox Width="18" Height="18">
                    <Path Data="M6,6 L18,18 M18,6 L6,18"
                          Stroke="{DynamicResource SystemFillColorCautionBrush}" StrokeThickness="2.2" StrokeLineJoin="Round" Fill="Transparent" />
                </Viewbox>
            </Button>
            <Button ToolTip="删除当前 ROI" Style="{DynamicResource ToolBarIconButtonStyle}" Click="Delete_Click">
                <Viewbox Width="18" Height="18">
                    <Path Data="M6,7 L18,7 M9,7 L9,19 M15,7 L15,19 M8,7 L8,20 L16,20 L16,7 M10,4 L14,4 L15,7"
                          Stroke="{DynamicResource SystemFillColorCriticalBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" />
                </Viewbox>
            </Button>
            <Button ToolTip="清空 ROI" Style="{DynamicResource ToolBarIconButtonStyle}" Click="Clear_Click">
                <Viewbox Width="18" Height="18">
                    <Path Data="M5,5 L19,19 M5,19 L19,5 M8,8 L16,8 L16,16 L8,16 Z"
                          Stroke="{DynamicResource SystemFillColorCriticalBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" />
                </Viewbox>
            </Button>

            <Separator />

            <Button ToolTip="保存 Region" Style="{DynamicResource ToolBarIconButtonStyle}" Click="SaveRegion_Click">
                <Viewbox Width="18" Height="18">
                    <Path Data="M5,4 L17,4 L20,7 L20,20 L4,20 L4,4 Z M8,4 L8,10 L16,10 L16,4 M8,20 L8,14 L16,14 L16,20"
                          Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" />
                </Viewbox>
            </Button>
            <Button ToolTip="打开 Region" Style="{DynamicResource ToolBarIconButtonStyle}" Click="OpenRegion_Click">
                <Viewbox Width="18" Height="18">
                    <Path Data="M4,6 L10,6 L12,8 L20,8 L20,19 L4,19 Z M8,14 C10,10 15,11 16,14 C18,15 16,18 12,18 C8,18 6,15 8,14"
                          Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" />
                </Viewbox>
            </Button>
            <Button ToolTip="清除叠加显示" Style="{DynamicResource ToolBarIconButtonStyle}" Click="ClearOverlay_Click">
                <Viewbox Width="18" Height="18">
                    <Path Data="M4,5 L20,5 L20,19 L4,19 Z M6,17 L18,7"
                          Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" />
                </Viewbox>
            </Button>
        </ToolBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <wfi:WindowsFormsHost Grid.Column="0">
                <vfc:HalconImageView x:Name="ImageView" />
            </wfi:WindowsFormsHost>
            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="16"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ROI 列表" Style="{StaticResource EditorSectionTitleStyle}" />
                    <ListBox x:Name="RoiList" SelectionChanged="RoiList_SelectionChanged" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
