<UserControl x:Class="VisionFlow.WpfToolEditors.Controls.NumericInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="40"
             Margin="0,0,0,12">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="ValueText"
                 Margin="0"
                 VerticalContentAlignment="Center"
                 PreviewTextInput="ValueText_PreviewTextInput"
                 TextChanged="ValueText_TextChanged"
                 LostFocus="ValueText_LostFocus" />
        <Grid Grid.Column="1" Margin="4,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <RepeatButton Content="▲" Padding="0" Click="Increase_Click" />
            <RepeatButton Grid.Row="1" Content="▼" Padding="0" Click="Decrease_Click" />
        </Grid>
    </Grid>
</UserControl>
