<Window x:Class="VisionFlow.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:vfc="clr-namespace:VisionFlow.Controls;assembly=VisionFlow.Controls"
        Title="VisionFlow WPF 编辑器"
        Width="1500"
        Height="900"
        MinWidth="1280"
        MinHeight="760"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button ToolTip="打开图像" Style="{StaticResource ToolBarIconButtonStyle}" Click="OpenImage_Click">
                    <Viewbox Width="18" Height="18">
                        <Path Data="M3,5 L21,5 L21,19 L3,19 Z M5,17 L10,12 L13,15 L15,13 L20,18 M16,8 L18,8 L18,10 L16,10 Z"
                              Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                </Button>
                <Button ToolTip="加载流程" Style="{StaticResource ToolBarIconButtonStyle}" Click="LoadFlow_Click">
                    <Viewbox Width="18" Height="18">
                        <Path Data="M4,6 L10,6 L12,8 L20,8 L20,19 L4,19 Z M8,13 L12,17 L16,13 M12,17 L12,10"
                              Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                </Button>
                <Button ToolTip="保存流程" Style="{StaticResource ToolBarIconButtonStyle}" Click="SaveFlow_Click">
                    <Viewbox Width="18" Height="18">
                        <Path Data="M5,4 L17,4 L20,7 L20,20 L4,20 L4,4 Z M8,4 L8,10 L16,10 L16,4 M8,20 L8,14 L16,14 L16,20"
                              Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                </Button>
                <Button ToolTip="校验流程" Style="{StaticResource ToolBarIconButtonStyle}" Click="Validate_Click">
                    <Viewbox Width="18" Height="18">
                        <Path Data="M12,3 L20,7 L20,12 C20,17 16,20 12,21 C8,20 4,17 4,12 L4,7 Z M8,12 L11,15 L17,9"
                              Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                </Button>
                <Button ToolTip="运行流程" Style="{StaticResource ToolBarIconButtonStyle}" Click="Run_Click">
                    <Viewbox Width="18" Height="18">
                        <Path Data="M7,5 L19,12 L7,19 Z" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                    </Viewbox>
                </Button>
                <Button ToolTip="停止运行" x:Name="StopButton" IsEnabled="False" Style="{StaticResource ToolBarIconButtonStyle}" Click="Stop_Click">
                    <Viewbox Width="18" Height="18">
                        <Path Data="M7,7 L17,7 L17,17 L7,17 Z" Fill="{DynamicResource SystemFillColorCriticalBrush}" />
                    </Viewbox>
                </Button>
                <Button ToolTip="系统显示设置" Style="{StaticResource ToolBarIconButtonStyle}" Click="DisplaySettings_Click">
                    <Viewbox Width="18" Height="18">
                        <Path Data="M12,4 C13,4 13.7,4.6 14,5.5 L14.3,6.4 L15.2,6.8 L16.1,6.4 C17,6 18,6.3 18.6,7.1 C19.1,7.9 19,8.9 18.3,9.6 L17.7,10.3 L17.8,11.3 L18.6,11.8 C19.4,12.3 19.7,13.3 19.4,14.2 C19.1,15.1 18.3,15.7 17.3,15.6 L16.4,15.5 L15.7,16.2 L15.6,17.1 C15.5,18.1 14.8,18.8 13.9,19 C13,19.2 12.1,18.8 11.7,17.9 L11.2,17.1 L10.2,17.1 L9.7,17.9 C9.3,18.8 8.4,19.2 7.5,19 C6.6,18.8 5.9,18.1 5.8,17.1 L5.7,16.2 L5,15.5 L4.1,15.6 C3.1,15.7 2.3,15.1 2,14.2 C1.7,13.3 2,12.3 2.8,11.8 L3.6,11.3 L3.7,10.3 L3.1,9.6 C2.4,8.9 2.3,7.9 2.8,7.1 C3.4,6.3 4.4,6 5.3,6.4 L6.2,6.8 L7.1,6.4 L7.4,5.5 C7.7,4.6 8.4,4 9.4,4 L12,4 Z M10.8,9 C9.1,9 7.8,10.3 7.8,12 C7.8,13.7 9.1,15 10.8,15 C12.5,15 13.8,13.7 13.8,12 C13.8,10.3 12.5,9 10.8,9 Z"
                              Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                </Button>
            </StackPanel>
            <TextBlock x:Name="TitleStatusText"
                       Margin="16,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="就绪" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="工具箱" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="点击图标添加到当前流程节点后；逻辑容器选中后会加入容器内部。鼠标悬停可查看工具名称。"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,8,0,0" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ToolboxPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="260" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="流程树" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="上移" MinWidth="56" Click="MoveUp_Click" />
                                <Button Content="下移" MinWidth="56" Click="MoveDown_Click" />
                                <Button Content="删除" MinWidth="56" Click="Delete_Click" />
                            </StackPanel>
                        </Grid>
                        <TreeView x:Name="FlowTree"
                                  SelectedItemChanged="FlowTree_SelectedItemChanged"
                                  MouseDoubleClick="FlowTree_MouseDoubleClick" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="参数" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ParameterPanel" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="图像显示" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox x:Name="OutputDisplayCombo"
                                      Grid.Column="1"
                                      MinWidth="260"
                                      Margin="12,0,8,0"
                                      SelectionChanged="OutputDisplayCombo_SelectionChanged"
                                      ToolTip="选择要显示的工具输出图像、区域或轮廓变量" />
                            <Button Grid.Column="2" Content="显示输入" MinWidth="76" Click="ShowInputImage_Click" />
                        </Grid>
                        <Border Background="Black"
                                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ClipToBounds="True">
                            <wfi:WindowsFormsHost x:Name="ImageHost">
                                <vfc:HalconImageView x:Name="ImageView" />
                            </wfi:WindowsFormsHost>
                        </Border>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="运行结果" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="变量" Margin="0,0,6,0">
                                <DataGrid x:Name="VariablesGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="2*" />
                                        <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="*" />
                                        <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="70" />
                                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="日志" Margin="6,0,0,0">
                                <DataGrid x:Name="LogGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="70" />
                                        <DataGridTextColumn Header="节点" Binding="{Binding NodeName}" Width="*" />
                                        <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="3*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="2" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="StatusText"
                       Margin="12,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="就绪" />
        </DockPanel>
    </Grid>
</Window>
