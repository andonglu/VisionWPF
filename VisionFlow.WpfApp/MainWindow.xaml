<Window x:Class="VisionFlow.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:vfc="clr-namespace:VisionFlow.Controls;assembly=VisionFlow.Controls"
        Title="VisionFlow WPF 编辑器"
        Width="1500"
        Height="900"
        MinWidth="1280"
        MinHeight="760"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{DynamicResource ToolBarBackgroundBrush}"
              Effect="{DynamicResource ToolBarShadowEffect}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="24,0"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="Medium"
                       Foreground="{DynamicResource PrimaryBrush}"
                       Text="VisionFlow" />
            <StackPanel Grid.ColumnSpan="3"
                        Panel.ZIndex="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button x:Name="NewFlowButton" ToolTip="新建流程" Style="{StaticResource ToolBarIconButtonStyle}" Click="NewFlow_Click">
                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="&#xf067;" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Button x:Name="LoadFlowButton" ToolTip="打开流程" Style="{StaticResource ToolBarIconButtonStyle}" Click="LoadFlow_Click">
                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="&#xf07c;" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Button x:Name="SaveFlowButton" ToolTip="保存流程（覆盖当前文件）" Style="{StaticResource ToolBarIconButtonStyle}" Click="SaveFlow_Click">
                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="&#xf0c7;" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Button x:Name="SaveFlowAsButton" ToolTip="流程另存为" Style="{StaticResource ToolBarIconButtonStyle}" Click="SaveFlowAs_Click">
                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="&#xf56e;" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Button x:Name="OpenImageButton" ToolTip="打开图像" Style="{StaticResource ToolBarIconButtonStyle}" Click="OpenImage_Click">
                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="&#xf03e;" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Border Width="1" Height="22" Margin="10,0" VerticalAlignment="Center"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="ValidateButton" ToolTip="校验流程" Style="{StaticResource ToolBarIconButtonStyle}" Click="Validate_Click">
                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="&#xf46c;" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Border Width="1" Height="22" Margin="10,0" VerticalAlignment="Center"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="RunButton" ToolTip="运行流程" Style="{StaticResource ToolBarIconButtonStyle}" Click="Run_Click">
                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" FontSize="14" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Text="&#xf04b;" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Button x:Name="DebugButton" ToolTip="调试运行（第一步即暂停；暂停中再次点击为单步/步入）" Style="{StaticResource ToolBarIconButtonStyle}" Click="Debug_Click">
                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="&#xf188;" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Button x:Name="StepOverButton" IsEnabled="False" ToolTip="逐过程（复合节点跳过子树）" Style="{StaticResource ToolBarIconButtonStyle}" Click="StepOver_Click">
                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="&#xf051;" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Button x:Name="ContinueButton" IsEnabled="False" ToolTip="继续运行到结束" Style="{StaticResource ToolBarIconButtonStyle}" Click="Continue_Click">
                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" FontSize="14" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Text="&#xf04e;" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Button x:Name="StopButton" IsEnabled="False" ToolTip="停止运行" Style="{StaticResource ToolBarIconButtonStyle}" Click="Stop_Click">
                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" FontSize="14" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="&#xf04d;" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Border Width="1" Height="22" Margin="10,0" VerticalAlignment="Center"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="CalibrationAssistantButton" ToolTip="标定助手（N 点标定）：选中“图像坐标转世界坐标”节点时打开其编辑窗口的标定页，否则单独打开（结果保存为标定文件）" Style="{StaticResource ToolBarIconButtonStyle}" Click="CalibrationAssistant_Click">
                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="&#xf05b;" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Border Width="1" Height="22" Margin="10,0" VerticalAlignment="Center"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Button ToolTip="系统显示设置" Style="{StaticResource ToolBarIconButtonStyle}" Click="DisplaySettings_Click">
                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="&#xf013;" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </StackPanel>
            <TextBlock x:Name="TitleStatusText"
                       Grid.Column="2"
                       Panel.ZIndex="2"
                       Width="360"
                       Margin="24,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextAlignment="Right"
                       TextTrimming="CharacterEllipsis"
                       Text="就绪" />
        </Grid>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,24,0" Style="{StaticResource PanelBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="工具箱" Style="{StaticResource EditorSectionTitleStyle}" />
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="点击图标添加到当前流程节点后；逻辑容器选中后会加入容器内部。鼠标悬停可查看工具名称。"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,16,0,0" />
                    <ScrollViewer Margin="0,0,-12,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ThinVerticalScrollBarStyle}" />
                        </ScrollViewer.Resources>
                        <StackPanel x:Name="ToolboxPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="0,0,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="260" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,24" Style="{StaticResource PanelBorderStyle}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="流程树" Style="{StaticResource EditorSectionTitleStyle}" Margin="0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="MoveUpButton" Content="上移" Click="MoveUp_Click" />
                                <Button x:Name="MoveDownButton" Content="下移" Click="MoveDown_Click" />
                                <Button x:Name="DeleteButton" Content="删除" Click="Delete_Click" />
                            </StackPanel>
                        </Grid>
                        <TreeView x:Name="FlowTree"
                                  SelectedItemChanged="FlowTree_SelectedItemChanged"
                                  MouseDoubleClick="FlowTree_MouseDoubleClick" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="参数" Style="{StaticResource EditorSectionTitleStyle}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ParameterPanel" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,24" Style="{StaticResource PanelBorderStyle}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="图像显示" Style="{StaticResource EditorSectionTitleStyle}" Margin="0" VerticalAlignment="Center" />
                            <ComboBox x:Name="OutputDisplayCombo"
                                      Grid.Column="1"
                                      MinWidth="260"
                                      Margin="16,0,8,0"
                                      SelectionChanged="OutputDisplayCombo_SelectionChanged"
                                      ToolTip="选择要显示的工具输出图像、区域或轮廓变量" />
                            <Button Grid.Column="2" Content="显示输入" Click="ShowInputImage_Click" />
                        </Grid>
                        <Border Background="Black"
                                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ClipToBounds="True">
                            <wfi:WindowsFormsHost x:Name="ImageHost">
                                <vfc:HalconImageView x:Name="ImageView" />
                            </wfi:WindowsFormsHost>
                        </Border>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="运行结果" Style="{StaticResource EditorSectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="变量" Margin="0,0,8,0">
                                <DataGrid x:Name="VariablesGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="2*" />
                                        <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="*" />
                                        <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="70" />
                                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="日志" Margin="8,0,0,0">
                                <DataGrid x:Name="LogGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="70" />
                                        <DataGridTextColumn Header="节点" Binding="{Binding NodeName}" Width="*" />
                                        <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="3*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="2" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="StatusText"
                       Margin="8,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="就绪" />
        </DockPanel>
    </Grid>
</Window>
