<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="ShellFont">Microsoft YaHei UI</FontFamily>

    <SolidColorBrush x:Key="SemightBlue" Color="#105186" />
    <SolidColorBrush x:Key="ColorBlue" Color="#3366CC" />
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F0F5FA" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToolBarForegroundBrush" Color="#00133B" />
    <SolidColorBrush x:Key="ToolBarBorderBrush" Color="#1A00133B" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#E5EDF4" />
    <SolidColorBrush x:Key="MenuButtonUnselectedForegroundBrush" Color="#00133B" />
    <SolidColorBrush x:Key="MenuButtonSelectedForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuButtonHoverBackground" Color="#1A3366CC" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#00133B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8000133B" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#1A00133B" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#19914B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E08A00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#D83340" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#858E9F" />

    <LinearGradientBrush x:Key="ToolBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F7FBFF" />
        <GradientStop Offset="1" Color="#FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenuButtonSelectedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#5F94FF" />
        <GradientStop Offset="1" Color="#3366CC" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F7FBFF" />
        <GradientStop Offset="1" Color="#FFFFFF" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="ToolBarShadowEffect" BlurRadius="4" Direction="270"
                      Opacity="0.30" ShadowDepth="2" Color="#00133B" />
    <DropShadowEffect x:Key="MenuButtonShadowEffect" BlurRadius="4"
                      Opacity="0.20" ShadowDepth="0" Color="#00133B" />
    <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="8" Direction="270"
                      Opacity="0.18" ShadowDepth="2" Color="#00133B" />

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource ShellFont}" />
        <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
    </Style>
    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="{StaticResource ShellFont}" />
    </Style>
    <Style x:Key="ShellCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
    </Style>
    <Style x:Key="ShellSectionStyle" TargetType="Border">
        <Setter Property="Background" Value="#F3F5F7" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>
</ResourceDictionary>
