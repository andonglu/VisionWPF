<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="HandyControl" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisionFlow.Base\VisionFlow.Base.csproj" />
    <ProjectReference Include="..\VisionFlow.EditorCore\VisionFlow.EditorCore.csproj" />
    <ProjectReference Include="..\VisionFlow.Tools\VisionFlow.Tools.csproj" />
    <ProjectReference Include="..\VisionFlow.Controls\VisionFlow.Controls.csproj" />
    <ProjectReference Include="..\VisionFlow.WpfToolEditors\VisionFlow.WpfToolEditors.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="halcondotnet">
      <HintPath>..\lib\halcon\halcondotnet.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
