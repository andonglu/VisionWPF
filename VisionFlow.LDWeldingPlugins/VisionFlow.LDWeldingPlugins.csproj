<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VisionFlow.Base\VisionFlow.Base.csproj" />
    <ProjectReference Include="..\VisionFlow.ToolEditors\VisionFlow.ToolEditors.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="halcondotnet">
      <HintPath>..\lib\halcon\halcondotnet.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PluginOutputDir>..\VisionFlow.App\bin\$(Configuration)\net9.0-windows\plugins\LDWelding</PluginOutputDir>
    <WpfPluginOutputDir>..\VisionFlow.WpfApp\bin\$(Configuration)\net9.0-windows\plugins\LDWelding</WpfPluginOutputDir>
  </PropertyGroup>

  <Target Name="CopyToVisionFlowPlugins" AfterTargets="Build">
    <MakeDir Directories="$(PluginOutputDir)" />
    <MakeDir Directories="$(WpfPluginOutputDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginOutputDir)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).deps.json" DestinationFolder="$(PluginOutputDir)" Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(WpfPluginOutputDir)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).deps.json" DestinationFolder="$(WpfPluginOutputDir)" Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />
  </Target>

</Project>
